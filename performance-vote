<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบให้คะแนนการแสดงปีใหม่ 2025</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>
</head>
<body class="bg-gradient-to-br from-purple-400 via-pink-500 to-red-500 min-h-screen p-4">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="bg-white rounded-2xl shadow-2xl p-6 mb-6 text-center">
            <h1 class="text-4xl font-bold bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent mb-2">
                🎪 การแข่งขันการแสดงปีใหม่ 2025 🎪
            </h1>
            <p class="text-gray-600 mb-2">ให้คะแนนทั้ง 5 ทีม ใน 3 หัวข้อ (1-5 คะแนน)</p>
            <div class="bg-purple-50 border-2 border-purple-200 rounded-lg p-3 mt-4">
                <p class="font-semibold text-purple-800 mb-2">เกณฑ์การให้คะแนน:</p>
                <div class="grid grid-cols-5 gap-2 text-sm text-center">
                    <div class="bg-red-100 rounded p-2">⭐ 1 = น้อยที่สุด</div>
                    <div class="bg-orange-100 rounded p-2">⭐⭐ 2 = น้อย</div>
                    <div class="bg-yellow-100 rounded p-2">⭐⭐⭐ 3 = ปานกลาง</div>
                    <div class="bg-lime-100 rounded p-2">⭐⭐⭐⭐ 4 = ดี</div>
                    <div class="bg-green-100 rounded p-2">⭐⭐⭐⭐⭐ 5 = ดีเยี่ยม</div>
                </div>
            </div>
        </div>

        <!-- Voting Form -->
        <div id="votingForm" class="bg-white rounded-2xl shadow-2xl p-6">
            <!-- Name Input -->
            <div class="mb-6 pb-6 border-b-2 border-gray-200">
                <label class="block text-lg font-semibold text-gray-700 mb-2">
                    ชื่อผู้ให้คะแนน *
                </label>
                <input
                    type="text"
                    id="voterName"
                    placeholder="กรอกชื่อของคุณ"
                    class="w-full px-4 py-3 border-2 border-purple-300 rounded-lg focus:outline-none focus:border-purple-500 text-lg"
                />
            </div>

            <!-- Progress -->
            <div class="mb-6 bg-gray-100 rounded-lg p-4">
                <div class="flex justify-between items-center mb-2">
                    <span class="font-semibold text-gray-700">ความคืบหน้า:</span>
                    <span id="progressText" class="text-purple-600 font-bold">0/15 คะแนน</span>
                </div>
                <div class="w-full bg-gray-300 rounded-full h-3">
                    <div id="progressBar" class="bg-gradient-to-r from-purple-600 to-pink-600 h-3 rounded-full transition-all" style="width: 0%"></div>
                </div>
            </div>

            <!-- Scoring Grid -->
            <div id="scoringGrid"></div>

            <!-- Submit Button -->
            <button
                id="submitBtn"
                class="w-full bg-gradient-to-r from-purple-600 to-pink-600 text-white py-4 rounded-xl font-bold text-xl transition-all shadow-lg transform hover:scale-105 hover:from-purple-700 hover:to-pink-700 mt-6"
            >
                📤 ส่งคะแนน
            </button>
        </div>

        <!-- Success Message -->
        <div id="successMessage" class="hidden bg-white rounded-2xl shadow-2xl p-8">
            <div class="text-center py-12">
                <div class="text-6xl mb-4">✅</div>
                <h2 class="text-3xl font-bold text-green-600 mb-2">
                    ขอบคุณสำหรับการให้คะแนน!
                </h2>
                <p class="text-gray-600 mb-2">คะแนนของคุณถูกบันทึกเรียบร้อยแล้ว</p>
                <p id="voterNameDisplay" class="text-sm text-gray-500 mb-8"></p>
                
                <button
                    id="voteAgainBtn"
                    class="px-8 py-3 bg-gray-500 text-white rounded-lg font-semibold hover:bg-gray-600 transition-all"
                >
                    ให้คะแนนอีกครั้ง
                </button>
            </div>
        </div>
    </div>

    <script>
        // Firebase Config
        const firebaseConfig = {
            apiKey: "AIzaSyBxQI-sxUkZshLoAq9sZQ5zKm-7NXyytfQ",
            authDomain: "newyear-party-vote.firebaseapp.com",
            databaseURL: "https://newyear-party-vote-default-rtdb.asia-southeast1.firebaseio.com",
            projectId: "newyear-party-vote",
            storageBucket: "newyear-party-vote.firebasestorage.app",
            messagingSenderId: "537539574238",
            appId: "1:537539574238:web:b7ed2507d1bcfc3203854f"
        };

        firebase.initializeApp(firebaseConfig);
        const database = firebase.database();

        // Configuration
        const CATEGORIES = [
            { id: 'cat1', name: 'ความสวยงาม ความพร้อมเพรียง' },
            { id: 'cat2', name: 'ลีลา และความต่อเนื่องในการแสดง' },
            { id: 'cat3', name: 'ความคิดริเริ่มสร้างสรรค์' }
        ];

        const TEAMS = [
            { 
                id: 't1', 
                name: 'ลูกหวัง แม่ก็หวัง', 
                members: ['ที', 'อ้น', 'นัท', 'ปูเป้', 'ข้าวโพด', 'ซัน', 'ส้ม', 'เปรียว', 'เฟิร์น', 'เป้', 'บอล', 'จูน'],
                color: '#8B5CF6'
            },
            { 
                id: 't2', 
                name: 'Varinda Distribution Center', 
                members: ['ตั้ง', 'ไอซ์', 'ดิว', 'วี', 'บังหรัง', 'บอส', 'นิก'],
                color: '#3B82F6'
            },
            { 
                id: 't3', 
                name: 'ECOM', 
                members: ['ทอดมัน', 'ตูน', 'มอส', 'แพรว', 'โซดา', 'ดา'],
                color: '#10B981'
            },
            { 
                id: 't4', 
                name: 'ชิงร้อยชิงล้าน', 
                members: ['สีน้ำ', 'ฝ้าย', 'เอื้อ', 'อิ้ง', 'ติ๊ด', 'แก้ม', 'อิ๋ว', 'บอส', 'หนิง', 'แพรว'],
                color: '#F59E0B'
            },
            { 
                id: 't5', 
                name: 'TYP ENTERTAINMENT', 
                members: ['บิว', 'ลิ้ม', 'ฟิ่ว', 'เต้ย', 'น็อต', 'แซม', 'ไนซ์', 'กัน', 'ตาล', 'เบล', 'พลอย'],
                color: '#EF4444'
            }
        ];

        let scores = {};

        // Initialize scores
        TEAMS.forEach(team => {
            scores[team.id] = {};
            CATEGORIES.forEach(category => {
                scores[team.id][category.id] = 0;
            });
        });

        // Render Scoring Grid
        function renderScoringGrid() {
            const container = document.getElementById('scoringGrid');
            
            const html = TEAMS.map((team, idx) => `
                <div class="mb-8 pb-8 ${idx < TEAMS.length - 1 ? 'border-b-2 border-gray-100' : ''}">
                    <div class="mb-5">
                        <div class="flex items-center gap-3 mb-3">
                            <div 
                                class="w-14 h-14 rounded-full flex items-center justify-center text-white font-bold text-xl shadow-lg"
                                style="background-color: ${team.color}"
                            >
                                ${idx + 1}
                            </div>
                            <div class="flex-1">
                                <h3 class="text-2xl font-bold text-gray-800">${team.name}</h3>
                                <p class="text-sm text-gray-500 font-semibold mt-1">
                                    👥 สมาชิก ${team.members.length} คน: ${team.members.join(', ')}
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        ${CATEGORIES.map((category, catIdx) => `
                            <div class="bg-gray-50 rounded-lg p-4">
                                <p class="font-semibold text-gray-700 mb-3">${catIdx + 1}. ${category.name}</p>
                                <div class="flex gap-2 justify-between">
                                    ${[1, 2, 3, 4, 5].map(score => `
                                        <button
                                            data-team="${team.id}"
                                            data-category="${category.id}"
                                            data-score="${score}"
                                            class="score-btn flex-1 py-3 px-2 rounded-lg border-2 transition-all text-center font-bold
                                                ${score === 1 ? 'border-red-300 hover:bg-red-100 hover:border-red-500' : ''}
                                                ${score === 2 ? 'border-orange-300 hover:bg-orange-100 hover:border-orange-500' : ''}
                                                ${score === 3 ? 'border-yellow-300 hover:bg-yellow-100 hover:border-yellow-500' : ''}
                                                ${score === 4 ? 'border-lime-300 hover:bg-lime-100 hover:border-lime-500' : ''}
                                                ${score === 5 ? 'border-green-300 hover:bg-green-100 hover:border-green-500' : ''}
                                            "
                                        >
                                            <div class="text-2xl mb-1">${score}</div>
                                            <div class="text-xs text-gray-600">
                                                ${'⭐'.repeat(score)}
                                            </div>
                                        </button>
                                    `).join('')}
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `).join('');

            container.innerHTML = html;

            // Add event listeners
            document.querySelectorAll('.score-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const teamId = this.dataset.team;
                    const categoryId = this.dataset.category;
                    const score = parseInt(this.dataset.score);
                    selectScore(teamId, categoryId, score, this);
                });
            });
        }

        function selectScore(teamId, categoryId, score, btnElement) {
            scores[teamId][categoryId] = score;

            // Update UI
            const buttons = document.querySelectorAll(`[data-team="${teamId}"][data-category="${categoryId}"]`);
            buttons.forEach(btn => {
                btn.classList.remove('ring-4', 'ring-purple-500', 'bg-red-100', 'bg-orange-100', 'bg-yellow-100', 'bg-lime-100', 'bg-green-100', 'scale-110');
                btn.classList.add('border-2');
            });

            const scoreValue = parseInt(btnElement.dataset.score);
            btnElement.classList.add('ring-4', 'ring-purple-500', 'scale-110');
            if (scoreValue === 1) btnElement.classList.add('bg-red-100');
            if (scoreValue === 2) btnElement.classList.add('bg-orange-100');
            if (scoreValue === 3) btnElement.classList.add('bg-yellow-100');
            if (scoreValue === 4) btnElement.classList.add('bg-lime-100');
            if (scoreValue === 5) btnElement.classList.add('bg-green-100');

            updateProgress();
        }

        function updateProgress() {
            let completed = 0;
            const total = TEAMS.length * CATEGORIES.length;

            TEAMS.forEach(team => {
                CATEGORIES.forEach(category => {
                    if (scores[team.id][category.id] > 0) {
                        completed++;
                    }
                });
            });

            const percentage = (completed / total) * 100;
            document.getElementById('progressBar').style.width = percentage + '%';
            document.getElementById('progressText').textContent = `${completed}/${total} คะแนน`;
        }

        // Submit Vote
        document.getElementById('submitBtn').addEventListener('click', async function() {
            const voterName = document.getElementById('voterName').value.trim();

            if (!voterName) {
                alert('กรุณากรอกชื่อของคุณ');
                return;
            }

            // Check if all scores are given
            let allScored = true;
            TEAMS.forEach(team => {
                CATEGORIES.forEach(category => {
                    if (scores[team.id][category.id] === 0) {
                        allScored = false;
                    }
                });
            });

            if (!allScored) {
                alert('กรุณาให้คะแนนให้ครบทุกทีมทุกหัวข้อ');
                return;
            }

            this.disabled = true;
            this.innerHTML = '<span>⏳</span> กำลังบันทึก...';

            try {
                const voteData = {
                    voterName: voterName,
                    scores: scores,
                    timestamp: firebase.database.ServerValue.TIMESTAMP
                };

                await database.ref('performances').push(voteData);

                document.getElementById('votingForm').classList.add('hidden');
                document.getElementById('successMessage').classList.remove('hidden');
                document.getElementById('voterNameDisplay').textContent = `ผู้ให้คะแนน: ${voterName}`;

            } catch (error) {
                alert('เกิดข้อผิดพลาด: ' + error.message);
                this.disabled = false;
                this.innerHTML = '<span>📤</span> ส่งคะแนน';
            }
        });

        // Vote Again
        document.getElementById('voteAgainBtn').addEventListener('click', function() {
            // Reset scores
            TEAMS.forEach(team => {
                CATEGORIES.forEach(category => {
                    scores[team.id][category.id] = 0;
                });
            });

            document.getElementById('voterName').value = '';
            document.getElementById('votingForm').classList.remove('hidden');
            document.getElementById('successMessage').classList.add('hidden');
            document.getElementById('submitBtn').disabled = false;
            document.getElementById('submitBtn').innerHTML = '<span>📤</span> ส่งคะแนน';
            
            renderScoringGrid();
            updateProgress();
        });

        // Initialize
        renderScoringGrid();
        updateProgress();
    </script>
</body>
</html>
